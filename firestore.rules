rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Clinical users collection for cross-device authentication and profile management
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Medical comparative records and patient dossiers
    match /records/{recordId} {
      allow read, write: if true;
    }
  }
}
